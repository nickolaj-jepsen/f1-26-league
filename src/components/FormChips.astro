---
import { positionLabel, type Entry, type Round } from '../lib/league';

interface Props {
  items: { round: Round; entry?: Entry }[];
}

const { items } = Astro.props;

function kind(e: Entry | undefined) {
  if (!e || e.status === 'dns') return 'dns';
  if (e.status !== 'finished') return 'dnf';
  if (e.pos === 1) return 'win';
  if (e.pos && e.pos <= 3) return 'podium';
  return e.points > 0 ? 'points' : 'none';
}
---

<span class="form" aria-label="Recent form">
  {
    items.map(({ round, entry }) => (
      <span class:list={['chip', kind(entry)]} title={`R${round.round} ${round.name}: ${positionLabel(entry)}`}>
        {positionLabel(entry).replace(/^P/, '')}
      </span>
    ))
  }
</span>

<style>
  .form {
    display: inline-flex;
    gap: 3px;
  }
  .chip {
    display: inline-grid;
    place-items: center;
    min-width: 2.1em;
    height: 1.75em;
    padding: 0 3px;
    font-stretch: 112%;
    font-size: 0.7rem;
    font-weight: 700;
    background: var(--surface-3);
    color: var(--text);
  }
  .win {
    background: var(--gold);
    color: #000;
  }
  .podium {
    background: var(--silver);
    color: #000;
  }
  .none {
    color: var(--muted);
  }
  .dnf {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--accent);
    color: var(--accent);
    font-size: 0.6rem;
  }
  .dns {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--dim);
    font-size: 0.6rem;
  }
</style>
