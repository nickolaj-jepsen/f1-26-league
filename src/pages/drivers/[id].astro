---
import Base from '../../layouts/Base.astro';
import NumberPlate from '../../components/NumberPlate.astro';
import TrackMap from '../../components/TrackMap.astro';
import Flag from '../../components/Flag.astro';
import { getLeague, driverStandings, entryFor, positionLabel, headToHead, onColor, url, type Driver } from '../../lib/league';

export async function getStaticPaths() {
  const league = await getLeague();
  return league.drivers.map((driver) => ({ params: { id: driver.id }, props: { driver } }));
}

interface Props {
  driver: Driver;
}

const { driver } = Astro.props;
const league = await getLeague();
const standings = driverStandings(league);
const champPos = standings.findIndex((s) => s.driver.id === driver.id) + 1;
const s = standings[champPos - 1];
const h2h = headToHead(league, driver);

const headline: [string, string | number][] = [
  ['Wins', s.wins],
  ['Podiums', s.podiums],
  ['Avg finish', s.avgFinish ? s.avgFinish.toFixed(1) : '—'],
  ['Best finish', s.bestFinish ? `P${s.bestFinish}` : '—'],
];
const plural = (n: number, word: string, many = `${word}s`) => `${n} ${n === 1 ? word : many}`;
const secondary = [
  plural(s.starts, 'start'),
  s.avgGrid !== undefined && `avg grid ${s.avgGrid.toFixed(1)}`,
  plural(s.fastestLaps, 'fastest lap'),
  plural(s.dnfs, 'DNF'),
  s.dns > 0 && plural(s.dns, 'DNS', 'DNS'),
  plural(s.warnings, 'warning'),
  plural(s.penalties, 'penalty', 'penalties'),
].filter(Boolean);

const rows = league.done.flatMap((round) =>
  round.sessions.map((session) => ({ round, session, e: entryFor(session, driver) })),
);
---

<Base title={driver.name}>
  <header class="hero slide-in" style={`--team: ${driver.team.color}; --on: ${onColor(driver.team.color)}`}>
    <span class="bignum" aria-hidden="true">{driver.number}</span>
    <div class="id">
      <NumberPlate driver={driver} size="lg" />
      <div>
        <h1>{driver.name}</h1>
        <p class="sub">{driver.gamertag} · {driver.team.name}</p>
      </div>
    </div>
    <div class="champ">
      <span class="cpos">P{champPos}</span>
      <span class="cpts">{s.points} <small>pts</small></span>
    </div>
  </header>

  <section>
    <div class="stats">
      {
        headline.map(([label, value], i) => (
          <div class="stat slide-in" style={`--i: ${i + 1}`}>
            <span class="value">{value}</span>
            <span class="label">{label}</span>
          </div>
        ))
      }
    </div>
    <p class="secondary">{secondary.join(' · ')}</p>
    <p class="muted note">Grid, warnings and penalties come only from exported races; screenshots don't show them.</p>
  </section>

  {
    h2h.length > 0 && (
      <section>
        <h2>Head-to-head</h2>
        <ol class="h2h">
          {h2h.map((h) => {
            const total = h.wins + h.losses;
            return (
              <li>
                <a class="opp" href={url(`drivers/${h.opponent.id}/`)}>
                  <span class="muted">vs</span>
                  <NumberPlate driver={h.opponent} size="sm" />
                  <span class="oname">{h.opponent.name}</span>
                </a>
                <span class="score">
                  <b>{h.wins}</b>–{h.losses}
                </span>
                <span class="bar" style={`--a: ${driver.team.color}; --b: ${h.opponent.team.color}`}>
                  <span class="a" style={`flex: ${h.wins}`} />
                  <span class="b" style={`flex: ${h.losses}`} />
                  {total === 0 && <span class="none" />}
                </span>
              </li>
            );
          })}
        </ol>
        <p class="muted note">Races where one finished ahead of the other. A finisher beats a DNF; races neither started don't count.</p>
      </section>
    )
  }

  <section>
    <h2>Results</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="num">Rnd</th>
            <th>Grand Prix</th>
            <th class="num hide-sm">Grid</th>
            <th class="num">Finish</th>
            <th class="num hide-sm">Best lap</th>
            <th class="num">Pts</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map(({ round, session, e }) => (
              <tr>
                <td class="num rnd">{round.round}</td>
                <td>
                  <a class="gp" href={url(`races/${round.id}/`)}>
                    <span class="mini">
                      <TrackMap track={round.track} />
                    </span>
                    <Flag code={round.flag} />
                    <span>{round.name}</span>
                  </a>
                  {session.type !== 'race' && <span class="badge">{session.type}</span>}
                </td>
                <td class="num hide-sm">{e?.grid ?? '—'}</td>
                <td class:list={['num', 'fin', { win: e?.pos === 1 && e.status === 'finished' }]}>{positionLabel(e)}</td>
                <td class="num hide-sm">{e?.fastestLap ? <span class="badge fl">{e.best}</span> : (e?.best ?? '—')}</td>
                <td class="num pts">{e?.points ?? 0}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  /* Hero: solid team colour, giant outline number behind. */
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding: 22px 24px;
    margin-bottom: 20px;
    background: linear-gradient(110deg, color-mix(in srgb, var(--team) 55%, #000), color-mix(in srgb, var(--team) 18%, var(--bg)) 65%);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%);
  }
  .bignum {
    position: absolute;
    right: -0.05em;
    top: 50%;
    transform: translateY(-50%);
    font-stretch: 125%;
    font-weight: 800;
    font-style: italic;
    font-size: clamp(8rem, 28vw, 15rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px rgb(255 255 255 / 0.12);
    pointer-events: none;
  }
  .id {
    display: flex;
    align-items: center;
    gap: 18px;
    position: relative;
  }
  .id h1 {
    margin: 0;
  }
  .sub {
    margin: 4px 0 0;
    color: rgb(255 255 255 / 0.75);
    font-weight: 500;
  }
  .champ {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-stretch: 125%;
    font-weight: 800;
    font-style: italic;
  }
  .cpos {
    font-size: 2.4rem;
  }
  .cpts {
    font-size: 1.6rem;
  }
  .cpts small {
    font-size: 0.5em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .stat {
    background: var(--surface);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
  }
  .value {
    font-stretch: 125%;
    font-weight: 800;
    font-style: italic;
    font-size: 2rem;
    line-height: 1.1;
  }
  .label {
    font-stretch: 112%;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .secondary {
    margin: 12px 0 2px;
    font-weight: 600;
  }
  .note {
    font-size: 0.8rem;
    margin: 4px 0 0;
  }

  /* Head-to-head */
  .h2h {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .h2h li {
    display: grid;
    grid-template-columns: minmax(0, 13em) 3.5em 1fr;
    align-items: center;
    gap: 14px;
    background: var(--surface);
    padding: 10px 16px;
  }
  .opp {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .oname {
    font-stretch: 125%;
    font-weight: 800;
    font-style: italic;
    text-transform: uppercase;
  }
  .score {
    font-stretch: 125%;
    font-size: 1.15rem;
    text-align: center;
    color: var(--muted);
  }
  .score b {
    color: var(--text);
  }
  .bar {
    display: flex;
    gap: 3px;
    height: 12px;
  }
  .bar .a {
    background: var(--a);
  }
  .bar .b {
    background: color-mix(in srgb, var(--b) 45%, transparent);
  }
  .bar .none {
    flex: 1;
    background: var(--surface-2);
  }
  @media (max-width: 560px) {
    .h2h li {
      grid-template-columns: 1fr auto;
      gap: 8px;
      padding: 10px 12px;
    }
    .bar {
      grid-column: 1 / -1;
    }
  }

  /* Results */
  .rnd {
    color: var(--muted);
    font-style: italic;
    font-weight: 700;
    width: 3em;
  }
  .gp {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 600;
    --track-w: 10;
    --track: var(--muted);
  }
  .gp:hover {
    --track: var(--text);
    text-decoration: underline;
  }
  .mini {
    width: 30px;
    height: 24px;
  }
  .fin {
    font-stretch: 125%;
    font-weight: 800;
    font-style: italic;
  }
  .fin.win {
    color: var(--gold);
  }
  .pts {
    font-weight: 700;
  }
</style>
